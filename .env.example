# ============================================================
# ForMe — Environment Variables Template
# ============================================================
#
# INSTRUCTIONS:
#   1. Copy this file to .env  (or .env.local for local dev)
#   2. Fill in your actual Firebase credentials
#   3. NEVER commit .env to Git — it is in .gitignore
#
# For Cloudflare Pages production deployment:
#   Set these as Environment Variables in the Cloudflare Pages
#   dashboard under Settings → Environment variables.
#
# ============================================================

# ── Firebase Configuration ──────────────────────────────────
# Obtain these values from:
# Firebase Console → Project Settings → Your apps → Web app → Config
#
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── Optional: Firebase Measurement ID (Analytics) ───────────
# Only required if you enable Google Analytics in Firebase
# VITE_FIREBASE_MEASUREMENT_ID=
